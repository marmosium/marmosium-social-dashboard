# --- Supabase ---
# supabase.com üzerinde proje oluşturduktan sonra "Project Settings > API" kısmından alınır
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sunucu tarafı (API route'ları) için, ASLA frontend'e/tarayıcıya sızdırılmaz
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Meta (Facebook/Instagram) ---
# Business Manager > Sistem Kullanıcıları > marmosium-api üzerinden oluşturduğunuz,
# süresi hiç dolmayan (Asla) sistem kullanıcısı token'ı
META_SYSTEM_USER_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_API_VERSION=v25.0

# --- Otomatik günlük senkronizasyon (Vercel Cron) ---
# Rastgele üretilmiş uzun bir metin olabilir (örn. `openssl rand -hex 32`).
# Vercel Cron, /api/sync'i çağırırken bunu "Authorization: Bearer <CRON_SECRET>" olarak otomatik ekler.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
